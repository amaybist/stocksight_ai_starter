# Frontend API origin. Use the backend URL accessible from the browser.
VITE_API_URL=http://127.0.0.1:8000

# Comma-separated development/deployment origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set a long random value before deployment. Do not commit your real .env.
STOCKSIGHT_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional; defaults to backend/stocksight.db
# STOCKSIGHT_DB_PATH=backend/stocksight.db

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
